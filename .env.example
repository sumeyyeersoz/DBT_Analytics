# Copy to .env (git-ignored) and fill in. Never commit real values.

# Google Cloud project used to bill/authorize BigQuery API calls (a free BigQuery sandbox project works).
GCP_PROJECT_ID=

# Snowflake key-pair authentication. Keep the private key OUTSIDE this repository.
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_ROLE=
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=DBT_PROJECT
SNOWFLAKE_PRIVATE_KEY_PATH=
# Leave empty if the private key is not encrypted.
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=
